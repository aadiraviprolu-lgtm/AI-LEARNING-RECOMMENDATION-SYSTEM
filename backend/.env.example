# Server
PORT=4000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/learnpath
# Set to true for hosted DBs that require SSL (Neon, Render, Supabase)
DB_SSL=false

# JWT - use a long random string (e.g. `openssl rand -hex 48`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed web origins (CORS)
CORS_ORIGINS=http://localhost:5173
